{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "killae-storefront",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "GARMENT_IMAGES"
    }
  ]
}
